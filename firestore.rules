rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "miss@mmcponsel.app"
      );
    }
    function member() { return signedIn() && request.auth.token.member == true; }

    match /products/{productId} {
      // Published catalog can be read by anyone using the app, including signed-out visitors.
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if admin() ||
        (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /users/{userId} {
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || admin() || member());
      allow update: if admin();
      match /cart/{cartId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
        allow read, delete: if admin() || member();
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin();
    }

    match /serviceRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin();
    }

    match /sellRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin();
    }

    match /solutionGroup/{groupId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      match /messages/{messageId} {
        allow read, create: if signedIn();
        allow update, delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    match /chats/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow read, update: if admin() || member();
      match /messages/{messageId} {
        allow read, create: if signedIn() && request.auth.uid == userId;
        allow read, create: if admin() || member();
      }
    }
  }
}
