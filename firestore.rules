rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == "miss@mmcponsel.app"; }
    function member() { return signedIn() && request.auth.token.member == true; }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if admin() || member();
      allow update, delete: if admin();
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow read, update: if admin() || member();
      match /cart/{cartId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
        allow read, delete: if admin() || member();
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin();
    }

    match /serviceRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin();
    }

    match /sellRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin();
    }

    // Grup solusi khusus Admin dan Member. Pengguna biasa tidak dapat masuk.
    match /solutionGroup/{groupId} {
      allow read: if admin() || member();
      allow create, update: if admin() || member();
      match /messages/{messageId} {
        allow read, create: if admin() || member();
        allow update, delete: if admin() || member();
      }
    }

    match /chats/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow read, update: if admin() || member();
      match /messages/{messageId} {
        allow read, create: if signedIn() && request.auth.uid == userId;
        allow read, create: if admin() || member();
      }
    }
  }
}
